{
  "name": "ozzium-base64-studio",
  "version": "1.0.0",
  "description": "Ozzium Base64 Studio (offline, local-only)",
  "main": "main.js",
  "author": "Ozzium",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "png-to-ico": "^2.1.0"
  },
  "build": {
    "appId": "com.ozzium.base64studio",
    "productName": "Ozzium Base64 Studio",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "icon": "build/icon.ico"
  }
}